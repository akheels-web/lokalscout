# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API (Structured synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cashfree Payments Gateway (https://www.cashfree.com)
# Obtain from Cashfree Merchant Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=TEST_CF_APP_ID
CASHFREE_SECRET_KEY=TEST_CF_SECRET_KEY
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=sandbox

# Google OAuth Client
GOOGLE_CLIENT_ID=

# Google Places API (New) - $200 free monthly credit on GCP
# Enable Places API on your GCP project and paste the API key here
GOOGLE_PLACES_API_KEY=

# SQLite Cache Database Path (defaults to data/lokalscout_cache.db)
LOKALSCOUT_DB_PATH=

# Security Secret
API_AUTH_SECRET=lokalscout_enterprise_secret_2026
