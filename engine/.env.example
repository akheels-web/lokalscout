# Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API (Structured synthesis)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Cashfree Payments Gateway (https://www.cashfree.com)
# Obtain from Cashfree Merchant Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=TEST_CF_APP_ID
CASHFREE_SECRET_KEY=TEST_CF_SECRET_KEY
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=sandbox

# Google OAuth Client
GOOGLE_CLIENT_ID=

# Security Secret
API_AUTH_SECRET=lokalscout_enterprise_secret_2026
